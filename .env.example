# Zerodha Kite Connect API credentials
# Get from https://kite.trade/
KITE_API_KEY=
KITE_API_SECRET=

# Redirect URL must match the one in Kite Connect app settings
# For local dev: http://127.0.0.1:5000/api/callback
REDIRECT_URL=http://127.0.0.1:5000/api/callback

# Optional: Flask secret for session
SECRET_KEY=your_random_secret_key
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=